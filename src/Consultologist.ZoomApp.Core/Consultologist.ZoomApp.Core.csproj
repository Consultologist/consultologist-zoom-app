<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The app's engine-facing core: the API client, the wire DTOs, the
    ConsultInputValue carrier, and the pure transcript/meeting logic (WEBVTT ->
    plain text; the transcript-submission request builder; the meeting->job
    map). It depends on nothing but the framework's System.Text.Json /
    System.Net.Http, so it builds and unit-tests without any Zoom or Azure
    plumbing. Everything verifiable about the scaffold lives here.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
