<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The host: an ASP.NET Core web app that is the Zoom General app. It signs the
    clinician into Microsoft Entra (Microsoft.Identity.Web) to call the engine as
    that clinician, holds the clinician's Zoom OAuth token to fetch the meeting
    transcript, serves the Zoom Apps-SDK panel from the Home URL, and exposes the
    thin panel-facing endpoints. The engine-facing logic lives in .Core.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Web" Version="4.14.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Consultologist.ZoomApp.Core\Consultologist.ZoomApp.Core.csproj" />
  </ItemGroup>

</Project>
