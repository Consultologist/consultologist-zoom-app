{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "//": "Placeholders only. Real client ids/secrets live in the git-ignored appsettings.Development.json (local) or App Service settings (deployed). See README.",

  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "{{TenantId}}",
    "ClientId": "{{ZoomAppEntraClientId}}",
    "ClientSecret": "{{ZoomAppEntraClientSecret}}",
    "CallbackPath": "/signin-oidc"
  },

  "Engine": {
    "ApiHost": "https://east.ca.api.consultologist.ai/api",
    "AccessAsUserScope": "api://b3866040-8bae-4c01-88ba-ecff646df451/access_as_user",
    "TranscriptInputSlot": "consult_draft",
    "PollIntervalSeconds": 3
  },

  "Zoom": {
    "ClientId": "{{ZoomClientId}}",
    "ClientSecret": "{{ZoomClientSecret}}",
    "RedirectUri": "{{PublicBaseUrl}}/zoom/callback",
    "Scopes": [ "cloud_recording:read" ]
  }
}
